# Cloudflare Pages reads this file; Vercel ignores it, so it is safe to keep in
# the tree while the site is deployed to either (PRD §9 P0 targets Cloudflare).
#
# Everything here is served from a static export, so the only real decision is
# how long each kind of file may be cached.

# Covers are keyed by YouTube video ID. A given ID's artwork never changes — a
# different cover means a different track, and so a different filename.
/covers/*
  Cache-Control: public, max-age=31536000, immutable

# Backdrops and loops have stable names and *can* change when `bun run assets`
# re-encodes them, so they get a day of freshness plus a week of serving the old
# copy while the new one is fetched in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Next's own output is content-hashed, so it can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The page embeds a YouTube player and nothing else; deny everything it does
  # not need, and never let the site be framed by someone else.
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
